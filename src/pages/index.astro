---
import "../styles/global.css";

const APP_URL = "https://app.pocketcrm.co";
const APP_HOST = new URL(APP_URL).host;

const arrowPath =
  "M2 9.5 C 9 8.5, 16 9.8, 23 9 M16 2.5 C 19 5, 21 7, 23.5 9 C 21 11, 18.5 13.5, 16 16";

// Ten circles in the call to action: the first one is filled with the accent color
const dots = Array.from({ length: 10 }, (_, i) => (i === 0 ? "fill-accent" : "fill-white"));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Личная CRM — лендинг</title>
    <meta
      name="description"
      content="Личная CRM для людей, а не для сделок. Кто это, откуда знакомы, о чём договорились — в одной карточке, находится за секунду."
    />
    <link rel="preload" href="/fonts/unbounded-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/golos-text-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="bg-dotted overflow-hidden font-body text-ink">
      <!-- Header -->
      <header class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-4 px-6 pt-7">
        <div class="flex items-center gap-3">
          <svg width="44" height="44" viewBox="0 0 44 44" aria-hidden="true">
            <path d="M8 6 C 18 4, 30 5, 38 7 C 40 17, 39 28, 37 38 C 26 40, 15 39, 6 37 C 5 27, 6 16, 8 6 Z" class="fill-yellow stroke-ink" stroke-width="2.5" stroke-linejoin="round"></path>
            <circle cx="22" cy="18" r="5.5" fill="none" class="stroke-ink" stroke-width="2.5"></circle>
            <path d="M12 33 C 14 26, 30 26, 32 33" fill="none" class="stroke-ink" stroke-width="2.5" stroke-linecap="round"></path>
          </svg>
          <span class="font-display text-2xl font-bold tracking-[-0.01em]">Личная CRM</span>
        </div>
        <a
          href={APP_URL}
          class="box-border inline-flex min-h-11 items-center rounded-sketch border-[2.5px] border-ink bg-white px-5.5 py-2.75 text-base font-semibold no-underline shadow-pop-xs"
        >Открыть CRM</a>
      </header>

      <!-- 1. Hero -->
      <section class="mx-auto flex max-w-page flex-wrap items-center gap-14 px-6 pt-18 pb-24">
        <div class="flex min-w-0 flex-[1_1_460px] flex-col gap-7">
          <span class="rotate-[-3deg] self-start font-hand text-hand font-bold text-red-text">для людей, а не для сделок</span>
          <h1 class="m-0 font-display text-hero leading-[1.02] font-extrabold tracking-[-0.03em]">
            Помни <span class="relative inline-block whitespace-nowrap">всех,<svg
                viewBox="0 0 300 24"
                preserveAspectRatio="none"
                aria-hidden="true"
                class="absolute bottom-[-0.2em] left-[-4%] h-[0.3em] w-[108%]"
              ><path d="M4 16 C 50 6, 96 20, 150 11 S 248 5, 296 13" fill="none" class="stroke-red" stroke-width="7" stroke-linecap="round"></path></svg></span> кого знаешь
          </h1>
          <p class="m-0 max-w-[520px] text-3xl leading-[1.5]">
            Личная CRM для людей, а не для сделок. Кто это, откуда знакомы, о чём договорились — в одной карточке, находится за секунду.
          </p>
          <div class="flex flex-wrap items-center gap-5">
            <a
              href={APP_URL}
              class="box-border inline-flex min-h-14 items-center gap-3 rounded-sketch border-3 border-ink bg-accent px-8.5 py-4.5 font-display text-xl font-bold text-ink no-underline shadow-pop-sm hover:text-ink"
            >Открыть CRM
              <svg width="26" height="18" viewBox="0 0 26 18" aria-hidden="true"><path d={arrowPath} fill="none" class="stroke-ink" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </a>
          </div>
        </div>

        <!-- Illustration: window with a contact card -->
        <div class="relative flex min-w-0 flex-[1_1_440px] justify-center py-5">
          <svg viewBox="0 0 120 120" aria-hidden="true" class="absolute top-[-18px] right-[2%] h-[110px] w-[110px] rotate-[10deg]">
            <path d="M60 8 L72 44 L110 46 L80 70 L92 108 L60 86 L28 108 L40 70 L10 46 L48 44 Z" class="fill-pink stroke-ink" stroke-width="3" stroke-linejoin="round"></path>
          </svg>
          <svg viewBox="0 0 140 60" aria-hidden="true" class="absolute bottom-[-10px] left-0 h-16 w-[150px]">
            <path d="M6 40 C 20 10, 36 54, 52 26 S 84 6, 96 34 S 124 52, 134 20" fill="none" class="stroke-green" stroke-width="5" stroke-linecap="round"></path>
          </svg>

          <div class="relative w-full max-w-[480px] rotate-[1.5deg] rounded-window border-3 border-ink bg-white shadow-window">
            <div class="flex items-center justify-between gap-3 rounded-window-bar border-b-3 border-ink bg-blue px-3.5 py-2.5">
              <span class="font-display text-xs font-medium text-white">контакты.bmp</span>
              <div class="flex gap-1.5" aria-hidden="true">
                <span class="block h-4 w-4 border-2 border-ink bg-yellow"></span>
                <span class="block h-4 w-4 border-2 border-ink bg-green"></span>
                <span class="block h-4 w-4 border-2 border-ink bg-red"></span>
              </div>
            </div>
            <div class="flex flex-col gap-4.5 p-5.5">
              <div class="flex items-center gap-2.5 rounded-sketch-alt border-[2.5px] border-ink bg-paper px-3.5 py-2.5">
                <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
                  <circle cx="9" cy="9" r="6.5" fill="none" class="stroke-ink" stroke-width="2.4"></circle>
                  <path d="M14 14 L20 20" class="stroke-ink" stroke-width="2.6" stroke-linecap="round"></path>
                </svg>
                <span class="text-md font-medium">Ири<span class="ml-px inline-block h-4.5 w-0.5 bg-ink align-[-3px]"></span></span>
                <span class="ml-auto text-2xs text-ink-muted">1 из 1 000</span>
              </div>
              <div class="flex items-center gap-4">
                <svg width="68" height="68" viewBox="0 0 68 68" aria-hidden="true">
                  <path d="M34 4 C 52 3, 64 16, 64 33 C 65 51, 51 64, 33 64 C 16 64, 4 52, 4 34 C 3 17, 16 5, 34 4 Z" class="fill-cyan stroke-ink" stroke-width="2.8"></path>
                  <circle cx="25" cy="29" r="2.8" class="fill-ink"></circle>
                  <circle cx="43" cy="29" r="2.8" class="fill-ink"></circle>
                  <path d="M23 42 C 29 48, 39 48, 45 41" fill="none" class="stroke-ink" stroke-width="2.8" stroke-linecap="round"></path>
                  <path d="M14 18 C 20 8, 44 6, 54 16" fill="none" class="stroke-ink" stroke-width="2.8" stroke-linecap="round"></path>
                </svg>
                <div class="flex flex-col gap-1">
                  <span class="font-display text-4xl font-bold">Ирина Соколова</span>
                  <span class="text-sm text-ink-muted">добавлена в марте</span>
                </div>
              </div>
              <div class="grid grid-cols-[116px_minmax(0,1fr)] gap-x-3.5 gap-y-2.5 text-base leading-[1.4]">
                <span class="text-ink-muted">Телефон</span><span class="font-medium">+7 900 000-00-00</span>
                <span class="text-ink-muted">Почта</span><span class="font-medium">irina@example.com</span>
                <span class="text-ink-muted">Откуда знакомы</span><span class="font-medium">конференция в Казани</span>
              </div>
              <div class="relative rotate-[-1.2deg] rounded-sketch border-[2.5px] border-ink bg-yellow px-4 py-3.5">
                <span class="block font-hand text-lg leading-none font-bold">договорились:</span>
                <span class="mt-1.5 block text-base font-medium">прислать ей презентацию до пятницы</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Palette divider -->
      <div aria-hidden="true" class="flex justify-center px-6">
        <div class="grid h-6.5 w-full max-w-[420px] grid-cols-7 border-3 border-ink">
          <span class="bg-ink"></span><span class="bg-red"></span><span class="bg-yellow"></span><span class="bg-green"></span><span class="bg-cyan"></span><span class="bg-blue"></span><span class="bg-pink"></span>
        </div>
      </div>

      <!-- 2. Problem -->
      <section class="mx-auto flex max-w-page flex-col gap-12 px-6 py-24">
        <div class="flex flex-col items-start gap-2.5">
          <span class="rotate-[-2deg] font-hand text-hand-lg font-bold text-red-text">знакомо?</span>
          <h2 class="m-0 max-w-[820px] font-display text-h2 leading-[1.1] font-bold tracking-[-0.02em]">Нужный человек есть — но найти его уже не получается</h2>
        </div>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-8">
          <div class="flex rotate-[-1deg] flex-col gap-4.5 rounded-sketch border-3 border-ink bg-white p-7 shadow-pop-pink">
            <svg width="150" height="96" viewBox="0 0 150 96" aria-hidden="true">
              <rect x="10" y="14" width="40" height="70" rx="8" class="fill-cyan stroke-ink" stroke-width="2.8" transform="rotate(-8 30 49)"></rect>
              <path d="M64 14 C 80 10, 100 12, 112 16 C 114 26, 112 34, 110 40 C 98 42, 84 42, 74 40 L 64 48 L 66 38 C 63 30, 62 22, 64 14 Z" class="fill-green stroke-ink" stroke-width="2.6" stroke-linejoin="round"></path>
              <path d="M86 52 C 104 50, 128 50, 140 54 C 142 62, 141 70, 139 76 L 146 86 L 132 79 C 118 81, 100 80, 88 78 C 85 70, 85 60, 86 52 Z" class="fill-blue stroke-ink" stroke-width="2.6" stroke-linejoin="round"></path>
              <rect x="40" y="64" width="44" height="26" class="fill-yellow stroke-ink" stroke-width="2.6" transform="rotate(12 62 77)"></rect>
            </svg>
            <p class="m-0 text-xl leading-[1.5]">Контакты разбросаны по телефону, WhatsApp, Telegram и визиткам в ящике стола.</p>
          </div>
          <div class="flex rotate-[0.8deg] flex-col gap-4.5 rounded-sketch-alt border-3 border-ink bg-white p-7 shadow-pop-yellow">
            <svg width="150" height="96" viewBox="0 0 150 96" aria-hidden="true">
              <path d="M48 8 C 72 6, 88 24, 88 48 C 89 72, 72 90, 48 89 C 24 90, 8 72, 8 48 C 7 24, 24 9, 48 8 Z" class="fill-paper stroke-ink" stroke-width="2.8"></path>
              <circle cx="35" cy="42" r="3.2" class="fill-ink"></circle>
              <circle cx="61" cy="42" r="3.2" class="fill-ink"></circle>
              <path d="M34 66 C 42 62, 54 64, 62 66" fill="none" class="stroke-ink" stroke-width="2.8" stroke-linecap="round"></path>
              <path d="M108 22 C 108 10, 132 8, 132 24 C 132 36, 118 36, 118 48" fill="none" class="stroke-red" stroke-width="5" stroke-linecap="round"></path>
              <circle cx="118" cy="62" r="3.8" class="fill-red"></circle>
            </svg>
            <p class="m-0 text-xl leading-[1.5]">Через полгода после встречи помнишь лицо, но не помнишь, где познакомились и что обещал.</p>
          </div>
          <div class="flex rotate-[-0.6deg] flex-col gap-4.5 rounded-sketch border-3 border-ink bg-white p-7 shadow-pop-cyan">
            <svg width="150" height="96" viewBox="0 0 150 96" aria-hidden="true">
              <path d="M44 10 C 64 9, 78 24, 78 42 C 78 60, 63 74, 44 74 C 25 74, 10 60, 10 42 C 10 24, 25 11, 44 10 Z" class="fill-white stroke-ink" stroke-width="2.8"></path>
              <path d="M68 64 L 94 88" class="stroke-ink" stroke-width="7" stroke-linecap="round"></path>
              <path d="M32 30 L 56 54 M56 30 L 32 54" class="stroke-red" stroke-width="5" stroke-linecap="round"></path>
              <path d="M104 20 C 116 26, 126 22, 138 28 M104 40 C 114 44, 128 40, 140 46" fill="none" class="stroke-ink" stroke-width="2.6" stroke-linecap="round" stroke-dasharray="2 7"></path>
            </svg>
            <p class="m-0 text-xl leading-[1.5]">Нужный человек есть — но найти его и вспомнить контекст уже не получается.</p>
          </div>
        </div>
      </section>

      <!-- 3. Solution -->
      <section class="border-y-3 border-ink bg-blue">
        <div class="mx-auto flex max-w-page flex-wrap items-start gap-14 px-6 py-24">
          <div class="flex min-w-0 flex-[1_1_380px] flex-col gap-3.5">
            <span class="rotate-[-2deg] self-start font-hand text-hand-lg font-bold text-yellow">решение</span>
            <h2 class="m-0 font-display text-h2 leading-[1.1] font-bold tracking-[-0.02em] text-white">Одно место для всех, кого знаешь лично</h2>
            <svg viewBox="0 0 220 70" aria-hidden="true" class="mt-3 h-16 w-[200px]">
              <path d="M8 20 C 60 10, 120 50, 190 40" fill="none" class="stroke-white" stroke-width="3.5" stroke-linecap="round"></path>
              <path d="M176 26 C 184 32, 190 36, 194 40 C 188 44, 182 50, 176 58" fill="none" class="stroke-white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <ol class="m-0 flex min-w-0 flex-[1_1_520px] list-none flex-col gap-5 p-0">
            <li class="flex items-start gap-5 rounded-sketch border-3 border-ink bg-white px-6.5 py-5.5 shadow-pop">
              <span class="flex h-12 w-12 flex-none items-center justify-center rounded-blob border-[2.5px] border-ink bg-yellow font-display text-2xl font-extrabold">1</span>
              <p class="m-0 pt-2 text-xl leading-[1.5]"><strong class="font-semibold">Карточка человека</strong> — имя, телефон, почта, откуда знакомы.</p>
            </li>
            <li class="flex items-start gap-5 rounded-sketch-alt border-3 border-ink bg-white px-6.5 py-5.5 shadow-pop">
              <span class="flex h-12 w-12 flex-none items-center justify-center rounded-blob-alt border-[2.5px] border-ink bg-green font-display text-2xl font-extrabold">2</span>
              <p class="m-0 pt-2 text-xl leading-[1.5]"><strong class="font-semibold">Заметки о договорённостях</strong> прямо в карточке.</p>
            </li>
            <li class="flex items-start gap-5 rounded-sketch border-3 border-ink bg-white px-6.5 py-5.5 shadow-pop">
              <span class="flex h-12 w-12 flex-none items-center justify-center rounded-blob border-[2.5px] border-ink bg-pink font-display text-2xl font-extrabold">3</span>
              <p class="m-0 pt-2 text-xl leading-[1.5]"><strong class="font-semibold">Поиск по имени</strong> — нужный контакт за пару секунд, даже среди тысячи.</p>
            </li>
          </ol>
        </div>
      </section>

      <!-- 4. Benefits -->
      <section class="mx-auto flex max-w-page flex-col gap-12 px-6 py-26">
        <div class="flex flex-col items-start gap-2.5">
          <span class="rotate-[-2deg] font-hand text-hand-lg font-bold text-red-text">что это даёт</span>
          <h2 class="m-0 font-display text-h2 leading-[1.1] font-bold tracking-[-0.02em]">Связи не теряются</h2>
        </div>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-7">
          <div class="flex rotate-[-1.2deg] flex-col gap-3.5 rounded-sketch border-3 border-ink bg-yellow px-6.5 py-7">
            <svg width="52" height="52" viewBox="0 0 52 52" aria-hidden="true"><path d="M18 30 C 12 36, 8 40, 10 44 C 14 48, 18 44, 24 38 M34 22 C 40 16, 44 12, 42 8 C 38 4, 34 8, 28 14 M20 32 L 32 20" fill="none" class="stroke-ink" stroke-width="3.2" stroke-linecap="round"></path></svg>
            <h3 class="m-0 font-display text-3xl leading-[1.2] font-bold">Не теряешь связи</h3>
            <p class="m-0 text-md leading-[1.5]">Каждое знакомство сохраняется с контекстом.</p>
          </div>
          <div class="flex rotate-[0.9deg] flex-col gap-3.5 rounded-sketch-alt border-3 border-ink bg-green px-6.5 py-7">
            <svg width="52" height="52" viewBox="0 0 52 52" aria-hidden="true"><path d="M8 28 C 14 32, 18 38, 22 44 C 28 30, 36 18, 46 8" fill="none" class="stroke-ink" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            <h3 class="m-0 font-display text-3xl leading-[1.2] font-bold">Держишь слово</h3>
            <p class="m-0 text-md leading-[1.5]">Договорённости записаны, а не «где-то в переписке».</p>
          </div>
          <div class="flex rotate-[-0.7deg] flex-col gap-3.5 rounded-sketch border-3 border-ink bg-cyan px-6.5 py-7">
            <svg width="52" height="52" viewBox="0 0 52 52" aria-hidden="true">
              <path d="M26 6 C 38 5, 47 14, 47 26 C 48 38, 38 47, 26 47 C 14 47, 5 38, 5 26 C 5 14, 14 7, 26 6 Z" fill="none" class="stroke-ink" stroke-width="3.2"></path>
              <path d="M26 14 L 26 27 L 35 32" fill="none" class="stroke-ink" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <h3 class="m-0 font-display text-3xl leading-[1.2] font-bold">Готов к встрече за минуту</h3>
            <p class="m-0 text-md leading-[1.5]">Открыл карточку — вспомнил, кто это и о чём говорили.</p>
          </div>
          <div class="flex rotate-[1.1deg] flex-col gap-3.5 rounded-sketch-alt border-3 border-ink bg-pink px-6.5 py-7">
            <svg width="52" height="52" viewBox="0 0 52 52" aria-hidden="true">
              <rect x="5" y="10" width="28" height="20" rx="3" fill="none" class="stroke-ink" stroke-width="3.2"></rect>
              <path d="M12 38 L 26 38" class="stroke-ink" stroke-width="3.2" stroke-linecap="round"></path>
              <rect x="32" y="20" width="15" height="26" rx="4" class="fill-pink stroke-ink" stroke-width="3.2"></rect>
            </svg>
            <h3 class="m-0 font-display text-3xl leading-[1.2] font-bold">Данные твои</h3>
            <p class="m-0 text-md leading-[1.5]">Хранятся на сервере, открываются с телефона и компьютера.</p>
          </div>
        </div>
      </section>

      <!-- 5. Call to action -->
      <section class="mx-auto max-w-page px-6 pb-28">
        <div class="relative flex flex-col items-center gap-8 rounded-cta border-[3.5px] border-ink bg-white px-7 py-cta-y text-center shadow-cta">
          <div aria-hidden="true" class="flex max-w-[560px] flex-wrap justify-center gap-2.5">
            {
              dots.map((fill) => (
                <svg width="40" height="40" viewBox="0 0 40 40">
                  <path d="M20 3 C 30 2, 37 10, 37 20 C 38 30, 30 37, 20 37 C 10 37, 3 30, 3 20 C 2 10, 10 4, 20 3 Z" class:list={[fill, "stroke-ink"]} stroke-width="2.6" />
                </svg>
              ))
            }
          </div>
          <h2 class="m-0 max-w-[860px] font-display text-cta leading-[1.08] font-extrabold tracking-[-0.025em]">
            Начни с первых <span class="relative inline-block whitespace-nowrap">десяти<svg
                viewBox="0 0 300 80"
                preserveAspectRatio="none"
                aria-hidden="true"
                class="absolute top-[-12%] left-[-8%] h-[124%] w-[116%]"
              ><path d="M150 6 C 240 4, 296 22, 294 42 C 292 64, 220 76, 140 74 C 60 72, 6 62, 8 40 C 10 18, 80 6, 172 10" fill="none" class="stroke-red" stroke-width="5" stroke-linecap="round"></path></svg></span> контактов
          </h2>
          <a
            href={APP_URL}
            class="box-border inline-flex min-h-15 items-center gap-3 rounded-sketch border-3 border-ink bg-accent px-10 py-5 font-display text-2xl font-bold text-ink no-underline shadow-pop-sm hover:text-ink"
          >Открыть CRM
            <svg width="26" height="18" viewBox="0 0 26 18" aria-hidden="true"><path d={arrowPath} fill="none" class="stroke-ink" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
        </div>
      </section>

      <footer class="border-t-3 border-ink bg-white">
        <div class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-4 px-6 py-7">
          <span class="font-display text-base font-bold">Личная CRM</span>
          <a href={APP_URL} class="text-base font-medium">{APP_HOST}</a>
        </div>
      </footer>
    </div>
  </body>
</html>
